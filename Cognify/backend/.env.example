PORT=3000
JWT_SECRET=change-me-in-production
GEMINI_API_KEY=

# Supabase session pooler on port 5432.
# Replace `cognify` with your own schema name if needed.
DATABASE_URL="postgresql://postgres.project-ref:your-password@aws-1-region.pooler.supabase.com:5432/postgres?sslmode=require&schema=cognify"

# Prisma CLI should use the same stable session pooler route on port 5432.
DIRECT_URL="postgresql://postgres.project-ref:your-password@aws-1-region.pooler.supabase.com:5432/postgres?sslmode=require&schema=cognify"
